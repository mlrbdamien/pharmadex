# URL du projet Supabase (Dashboard > Project Settings > Data API)
# ex. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Clé publique côté navigateur. Selon l'âge du projet Supabase elle s'appelle
# « anon key » (eyJ...) ou « publishable key » (sb_publishable_...).
# Les deux sont sûres à exposer : la sécurité repose sur la RLS, pas sur la clé.
VITE_SUPABASE_ANON_KEY=
